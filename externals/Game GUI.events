@group "Pause and settings" source="" creationTime=0 color=[118,102,192] parameters=[]
@event aiGeneratedEventId="initialize-pause-and-playability-ui"
if SceneJustBegins
do SetNumberVariable variable="PauseOpen" modification_sign="=" value="0"
do SetNumberVariable variable="MouseSensitivity" modification_sign="=" value="0.12"
do SetNumberVariable variable="MasterVolume" modification_sign="=" value="80"
do SetNumberVariable variable="TutorialVisible" modification_sign="=" value="1"
do SetNumberVariable variable="CombatCueKind" modification_sign="=" value="0"
do SetNumberVariable variable="HealUsed" modification_sign="=" value="0"
do ResetTimer timer_name="\"TutorialHint\""
do ResetTimer timer_name="\"CombatCue\""
do SetGlobalVolume modification_sign="=" volume_0_100="Variable(MasterVolume)"
> @event
> for each "PauseWindow"
>> @event
>> do Hide object="PauseWindow"
> @event
> for each "EnemyHealthText"
>> @event
>> do Hide object="EnemyHealthText"
> @event
> for each "CombatCue"
>> @event
>> do Hide object="CombatCue"
> @event
> for each "GoldPickup"
>> @event
>> do Hide object="GoldPickup"
> @event
> for each "StonePickup"
>> @event
>> do Hide object="StonePickup"
> @event
> for each "WoodPickup"
>> @event
>> do Hide object="WoodPickup"
> @event
> for each "HealPickup"
>> @event
>> do Hide object="HealPickup"

@event aiGeneratedEventId="toggle-pause-with-escape"
if KeyFromTextJustPressed key_to_check="\"Escape\""
if NumberVariable variable="DialogueOpen" comparison_sign="=" value="0"
if NumberVariable variable="BackpackOpen" comparison_sign="=" value="0"
if NumberVariable variable="GameEnded" comparison_sign="=" value="0"
do SetNumberVariable variable="PauseOpen" modification_sign="=" value="1 - Variable(PauseOpen)"
do PlaySound audio_file_or_audio_resource_name="assets/sfx/ui_toggle.wav" repeat_the_sound="no" volume="24" pitch_speed="0.9"
> @event aiGeneratedEventId="open-pause-window"
> if NumberVariable variable="PauseOpen" comparison_sign="=" value="1"
>> @event
>> for each "PauseWindow"
>>> @event
>>> do Show object="PauseWindow"
>> @event
>> for each "Knight"
>>> @event
>>> do ActivateBehavior object="Knight" behavior="Platformer3DKeyboardMapper" activate="no"
>> @event
>> for each "Skeleton_Minion"
>>> @event
>>> do PauseObjectTimer object="Skeleton_Minion" timer_name="\"AttackWindup\""
>>> do PauseObjectTimer object="Skeleton_Minion" timer_name="\"AttackCooldown\""
>> @event
>> if MousePointerLock::isPointerLocked
>> do MousePointerLock::ExitPointerLock
> @event aiGeneratedEventId="close-pause-window"
> if NumberVariable variable="PauseOpen" comparison_sign="=" value="0"
>> @event
>> for each "PauseWindow"
>>> @event
>>> do Hide object="PauseWindow"
>> @event
>> for each "Knight"
>>> @event
>>> do ActivateBehavior object="Knight" behavior="Platformer3DKeyboardMapper" activate="yes"
>> @event
>> for each "Skeleton_Minion"
>>> @event
>>> do UnPauseObjectTimer object="Skeleton_Minion" timer_name="\"AttackWindup\""
>>> do UnPauseObjectTimer object="Skeleton_Minion" timer_name="\"AttackCooldown\""

@event aiGeneratedEventId="decrease-pause-mouse-sensitivity"
if NumberVariable variable="PauseOpen" comparison_sign="=" value="1"
if KeyFromTextJustPressed key_to_check="\"Left\""
do SetNumberVariable variable="MouseSensitivity" modification_sign="=" value="clamp(Variable(MouseSensitivity) - 0.02, 0.06, 0.24)"

@event aiGeneratedEventId="increase-pause-mouse-sensitivity"
if NumberVariable variable="PauseOpen" comparison_sign="=" value="1"
if KeyFromTextJustPressed key_to_check="\"Right\""
do SetNumberVariable variable="MouseSensitivity" modification_sign="=" value="clamp(Variable(MouseSensitivity) + 0.02, 0.06, 0.24)"

@event aiGeneratedEventId="increase-pause-master-volume"
if NumberVariable variable="PauseOpen" comparison_sign="=" value="1"
if KeyFromTextJustPressed key_to_check="\"Up\""
do SetNumberVariable variable="MasterVolume" modification_sign="=" value="clamp(Variable(MasterVolume) + 10, 0, 100)"
do SetGlobalVolume modification_sign="=" volume_0_100="Variable(MasterVolume)"

@event aiGeneratedEventId="decrease-pause-master-volume"
if NumberVariable variable="PauseOpen" comparison_sign="=" value="1"
if KeyFromTextJustPressed key_to_check="\"Down\""
do SetNumberVariable variable="MasterVolume" modification_sign="=" value="clamp(Variable(MasterVolume) - 10, 0, 100)"
do SetGlobalVolume modification_sign="=" volume_0_100="Variable(MasterVolume)"

@event aiGeneratedEventId="write-pause-settings"
if NumberVariable variable="PauseOpen" comparison_sign="=" value="1"
> @event
> if StringVariable variable="Locale" comparison_sign="=" value="\"{{i18n.defaultLocale}}\""
>> @event
>> for each "PauseTitle"
>>> @event
>>> do TextContainerCapability::TextContainerBehavior::SetValue object="PauseTitle" behavior="Text" modification_sign="=" text="\"{{localization['hud.pause.title'].en}}\""
>> @event
>> for each "PauseText"
>>> @event
>>> do TextContainerCapability::TextContainerBehavior::SetValue object="PauseText" behavior="Text" modification_sign="=" text="\"{{localization['hud.pause.resume'].en}}\" + NewLine() + NewLine() + \"{{localization['hud.pause.sensitivity'].en}}:  \" + ToString(round(Variable(MouseSensitivity) * 100)) + \"%\" + NewLine() + \"{{localization['hud.pause.volume'].en}}:  \" + ToString(Variable(MasterVolume)) + \"%\""
> @event
> if StringVariable variable="Locale" comparison_sign="=" value="\"{{i18n.alternateLocale}}\""
>> @event
>> for each "PauseTitle"
>>> @event
>>> do TextContainerCapability::TextContainerBehavior::SetValue object="PauseTitle" behavior="Text" modification_sign="=" text="\"{{localization['hud.pause.title'].cn}}\""
>> @event
>> for each "PauseText"
>>> @event
>>> do TextContainerCapability::TextContainerBehavior::SetValue object="PauseText" behavior="Text" modification_sign="=" text="\"{{localization['hud.pause.resume'].cn}}\" + NewLine() + NewLine() + \"{{localization['hud.pause.sensitivity'].cn}}：\" + ToString(round(Variable(MouseSensitivity) * 100)) + \"%\" + NewLine() + \"{{localization['hud.pause.volume'].cn}}：\" + ToString(Variable(MasterVolume)) + \"%\""
@end group

@group "Knight backpack" source="" creationTime=0 color=[255,180,72] parameters=[]
@event aiGeneratedEventId="pin-backpack-ui-camera"
if BuiltinCommonInstructions::CompareNumbers first_expression="1" comparison_sign="=" second_expression="1"
do SetCameraCenterX modification_sign="=" value="640" layer="\"Backpack UI\"" camera_number_default_0="0"
do SetCameraCenterY modification_sign="=" value="360" layer="\"Backpack UI\"" camera_number_default_0="0"

