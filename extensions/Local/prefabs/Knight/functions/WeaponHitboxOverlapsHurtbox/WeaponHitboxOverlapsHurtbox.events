@event aiGeneratedEventId="initialize-weapon-hitbox-overlap-result"
do SetReturnBoolean should_the_condition_be_true_or_false="False"

@event aiGeneratedEventId="sword-hit-window-active"
if BooleanVariable variable="AttackWindowOpen" check_if_the_value_is="True"
if StringVariable variable="Weapon" comparison_sign="=" value="\"Sword\""
if StringVariable variable="AnimationState" comparison_sign="startsWith" value="\"Attack.Sword.\""
if CompareObjectTimer object="Object" timer_name="\"HitCooldown\"" comparison_sign=">=" time_in_seconds="0.35"
do SetReturnBoolean should_the_condition_be_true_or_false="True"

@event aiGeneratedEventId="axe-hit-window-active"
if BooleanVariable variable="AttackWindowOpen" check_if_the_value_is="True"
if StringVariable variable="Weapon" comparison_sign="=" value="\"Axe\""
if StringVariable variable="AnimationState" comparison_sign="startsWith" value="\"Attack.Axe.\""
if CompareObjectTimer object="Object" timer_name="\"HitCooldown\"" comparison_sign=">=" time_in_seconds="0.35"
do SetReturnBoolean should_the_condition_be_true_or_false="True"
