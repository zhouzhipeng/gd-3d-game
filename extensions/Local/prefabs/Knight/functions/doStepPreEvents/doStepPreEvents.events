>> do EmitSceneSignal signal_name="\"Knight.AnimationStateChanged\"" payload="ToString(Object.InstanceId()) + \"|Idle.Axe\""
>> do PlaySound audio_file_or_audio_resource_name="assets/sfx/weapon_equip.wav" repeat_the_sound="no" volume="34" pitch_speed="0.86"

>> @event aiGeneratedEventId="equip-knight-sword-state"
