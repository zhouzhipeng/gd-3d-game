@event aiGeneratedEventId="play-knight-grounded-run-footstep"
if StringVariable variable="AnimationState" comparison_sign="=" value="\"Run\""
if Physics3D::PhysicsCharacter3D::IsOnFloor object="Object" behavior="PhysicsCharacter3D"
if Physics3D::PhysicsCharacter3D::IsMovingEvenALittle object="Object" behavior="PhysicsCharacter3D"
if CompareObjectTimer object="Object" timer_name="\"Footstep\"" comparison_sign=">=" time_in_seconds="0.32"
do PlaySound audio_file_or_audio_resource_name="assets/sfx/knight_footstep.wav" repeat_the_sound="no" volume="28" pitch_speed="RandomFloatInRange(0.94, 1.06)"
do ResetObjectTimer object="Object" timer_name="\"Footstep\""

@event aiGeneratedEventId="smooth-knight-turn-toward-movement"
if BuiltinCommonInstructions::CompareNumbers first_expression="abs(AngleDifference(Object.Angle(), Object.PhysicsCharacter3D::ForwardAngle()))" comparison_sign=">" second_expression="0.5"
do SetAngle object="Object" modification_sign="=" angle_in_degrees="lerpAngle(Object.Angle(), Object.PhysicsCharacter3D::ForwardAngle(), 1 - exp(-10 * TimeDelta()))"
@end group
