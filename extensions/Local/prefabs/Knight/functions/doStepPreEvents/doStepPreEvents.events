>> do SetStringVariable variable="Weapon" modification_sign="=" value="\"Sword\""
>> do Hide object="Axe3D"
>> do Show object="Sword3D"
>> do SetStringVariable variable="PreviousAnimationState" modification_sign="=" value="AnimationState"
>> do SetStringVariable variable="AnimationState" modification_sign="=" value="\"Idle.Sword\""
>> do ResetObjectTimer object="Object" timer_name="\"AnimationState\""
>> do AnimatableCapability::AnimatableBehavior::SetSpeedScale object="Knight3D" behavior="Animation" modification_sign="=" speed_scale="1"
>> do AnimatableCapability::AnimatableBehavior::SetName object="Knight3D" behavior="Animation" modification_sign="=" animation_name="\"Melee_Unarmed_Idle\""
>> do AnimatableCapability::AnimatableBehavior::SetElapsedTime object="Knight3D" behavior="Animation" modification_sign="=" elapsed_time_in_seconds="0"
>> do EmitSceneSignal signal_name="\"Knight.WeaponChanged\"" payload="ToString(Object.InstanceId()) + \"|Sword\""
>> do EmitSceneSignal signal_name="\"Knight.AnimationStateChanged\"" payload="ToString(Object.InstanceId()) + \"|Idle.Sword\""
>> do PlaySound audio_file_or_audio_resource_name="assets/sfx/weapon_equip.wav" repeat_the_sound="no" volume="32" pitch_speed="1.08"
